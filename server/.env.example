# Render sets PORT automatically. Keep this only for local development.
PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/scanrig?retryWrites=true&w=majority
JWT_SECRET=generate-a-long-random-secret
# Exact Netlify production origin. Multiple origins can be comma-separated.
CLIENT_ORIGIN=https://YOUR-SITE.netlify.app

# Optional private administrator account. If omitted, no admin account is created.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=ScanRig Admin

# Public demo uses the pretrained ONNX model bundled with the frontend.
# Keep server-side retraining disabled unless the Python AI package is deployed too.
ENABLE_AI_TRAINING=false
AI_TRAINING_DIR=../scanrig-ai
PYTHON_BIN=
AI_TRAINING_EPOCHS=60

# Optional server-side Gemini feature.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
